{
  "name": "renovation-tracker-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for a home renovation project tracker: contractors and homeowners collaborate on jobs, with job history, undo/redo, async PDF reports and real-time messaging.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/api.ts",
    "dev:worker": "node --env-file=.env --import tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/api.js",
    "start:worker": "node --env-file=.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "bcryptjs": "^3.0.3",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "graphql-yoga": "^5.24.6",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
